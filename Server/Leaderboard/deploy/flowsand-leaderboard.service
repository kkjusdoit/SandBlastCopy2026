[Unit]
Description=FlowSand Leaderboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowsand
Group=flowsand
WorkingDirectory=/srv/sandrussia/current
EnvironmentFile=/srv/sandrussia/shared/leaderboard.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sandrussia/shared

[Install]
WantedBy=multi-user.target
