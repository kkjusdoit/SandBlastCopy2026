<?xml version="1.0" encoding="utf-8"?>
<PromptUGUI version="1">
  <Theme name="flow-sand">
    <Color name="background" value="#070914"/>
    <Color name="surface" value="#0D1124"/>
    <Color name="surface-raised" value="#121A35"/>
    <Color name="line" value="#24557A"/>
    <Color name="accent" value="#3EC9FF"/>
    <Color name="accent-pressed" value="#168EC2"/>
    <Color name="gold" value="#FFCA40"/>
    <Color name="text" value="#F4F8FF"/>
    <Color name="muted" value="#8FA7C4"/>
    <Color name="dimmer" value="#050710D9"/>
  </Theme>

  <Screen name="FlowSand" reference="1080x1920" reference.portrait="1080x1920" scale-mode="pixel">
    <Image anchor="stretch" color="background" raycastTarget="false"/>
    <SafeArea>
      <Frame anchor="top-stretch" height="220" margin="34,42,0,42">
        <Text anchor="top-left" size="280x54" fontSize="26" color="muted">CURRENT SCORE</Text>
        <Text id="scoreText" anchor="bottom-left" size="360x130" fontSize="88" color="text" autosize="true">0</Text>

        <Frame anchor="top-right" size="330x170">
          <Text anchor="top-right" size="200x48" fontSize="24" align="top-right" color="muted">PERSONAL BEST</Text>
          <Text id="bestText" anchor="bottom-right" size="260x96" fontSize="52" align="bottom-right" color="gold">0</Text>
        </Frame>

        <Btn id="pauseButton" anchor="top-center" size="190x76" fontSize="28"
             color="surface-raised" textColor="text" hoverColor="line"
             pressedColor="accent-pressed" pressedOffset="0,-3">PAUSE</Btn>
      </Frame>

      <Frame anchor="stretch" margin="250,280,270,48">
        <Image anchor="stretch" color="line" raycastTarget="false"/>
        <Frame anchor="stretch" margin="5">
          <Image anchor="stretch" color="surface" raycastTarget="false"/>
          <RawImage id="boardImage" anchor="stretch" margin="18"/>
        </Frame>
      </Frame>

      <Frame anchor="top-right" size="220x520" margin="270,34,0,0">
        <Text anchor="top-stretch" height="50" fontSize="25" align="middle-center" color="muted">NEXT</Text>
        <Frame anchor="top-stretch" height="220" margin="58,0,0,0">
          <Image anchor="stretch" color="line" raycastTarget="false"/>
          <Frame anchor="stretch" margin="4">
            <Image anchor="stretch" color="surface" raycastTarget="false"/>
            <RawImage id="nextImage" anchor="stretch" margin="20" type="contain"/>
          </Frame>
        </Frame>
        <Text anchor="top-stretch" height="42" margin="320,0,0,0" fontSize="23" align="middle-center" color="muted">SPEED</Text>
        <Text id="speedText" anchor="top-stretch" height="90" margin="365,0,0,0" fontSize="58" align="middle-center" color="text">1</Text>
      </Frame>

      <HStack anchor="bottom-stretch" height="160" margin="0,42,42,42" spacing="14">
        <Btn id="leftButton" height="190" width="235" fontSize="32" color="surface-raised"
             textColor="text" hoverColor="line" pressedColor="accent-pressed" pressedOffset="0,-4">LEFT</Btn>
        <Btn id="rightButton" height="190" width="235" fontSize="32" color="surface-raised"
             textColor="text" hoverColor="line" pressedColor="accent-pressed" pressedOffset="0,-4">RIGHT</Btn>
        <Btn id="rotateButton" height="190" width="235" fontSize="32" color="surface-raised"
             textColor="text" hoverColor="line" pressedColor="accent-pressed" pressedOffset="0,-4">ROTATE</Btn>
        <Btn id="dropButton" height="190" width="235" fontSize="32" color="accent"
             textColor="background" hoverColor="#68D7FF" pressedColor="accent-pressed" pressedOffset="0,-4">DROP</Btn>
      </HStack>
    </SafeArea>

    <Image id="dimmer" anchor="stretch" color="dimmer"/>
    <Frame id="overlayPanel" anchor="center" size="840x720">
      <Image anchor="stretch" color="accent" raycastTarget="false"/>
      <Frame anchor="stretch" margin="5">
        <Image anchor="stretch" color="surface" raycastTarget="false"/>
        <Text id="titleText" anchor="top-stretch" height="190" margin="72,60,0,60"
              fontSize="76" autosize="true" align="middle-center" color="text">FLOW SAND</Text>
        <Text id="subtitleText" anchor="top-stretch" height="150" margin="270,70,0,70"
              fontSize="30" align="top-center" color="muted">Build. Crumble. Connect.</Text>
        <Text id="messageText" anchor="top-stretch" height="100" margin="430,70,0,70"
              fontSize="26" align="middle-center" color="text"/>
        <Btn id="overlayButton" anchor="bottom-center" size="420x112" margin="0,0,62,0"
             fontSize="36" color="accent" textColor="background"
             hoverColor="#68D7FF" pressedColor="accent-pressed" pressedOffset="0,-4">START</Btn>
      </Frame>
    </Frame>
  </Screen>
</PromptUGUI>
